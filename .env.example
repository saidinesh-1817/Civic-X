# CivicSense API Environment Configuration

# Server Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# API Version Prefix
API_PREFIX=/api

# CORS Allowed Origins (comma-separated or single origin, e.g. http://localhost:3000,http://localhost:5173)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Connection URL (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicsense?schema=public"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
