# CivicSense API Environment Configuration

# Server Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# API Version Prefix
API_PREFIX=/api

# CORS / Frontend Origins (e.g. Lovable web app, localhost:3000, localhost:5173)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Connection URL (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicsense?schema=public"

# Authentication & JWT Configuration
JWT_SECRET="replace_with_a_long_random_secret_in_production"
JWT_EXPIRES_IN="7d"

# Development / Seed Admin Credentials
ADMIN_EMAIL="demo.admin@civicsense.local"
ADMIN_PASSWORD="AdminSecure123!"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=30
